NODE_ENV=development
PORT=10000

# Your app's own public HTTPS URL (Render gives you this after first deploy,
# e.g. https://your-app.onrender.com). Required for TELEPHONY_PROVIDER=twilio
# — Twilio needs a real URL to call back into for conversation TwiML.
PUBLIC_BASE_URL=

# --- Database (Neon Postgres pooled connection string) ---
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/leomox?sslmode=require

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# --- AI Provider (LLM) ---
# Valid values: mock, gemini
# gemini requires AI_API_KEY (get one at https://aistudio.google.com/apikey)
AI_PROVIDER=mock
AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Speech to Text ---
# Valid values: mock only (real STT is handled via Twilio's built-in
# <Gather input="speech"> when TELEPHONY_PROVIDER=twilio — no separate STT
# vendor needed for phone calls). A standalone STT provider isn't implemented.
STT_PROVIDER=mock
STT_API_KEY=

# --- Text to Speech ---
# Valid values: mock only (real TTS is handled via Twilio's built-in <Say>
# when TELEPHONY_PROVIDER=twilio). A standalone TTS provider isn't implemented.
TTS_PROVIDER=mock
TTS_API_KEY=

# --- Telephony ---
# Valid values: mock, twilio
# twilio requires TELEPHONY_API_KEY (Account SID), TELEPHONY_API_SECRET
# (Auth Token), TELEPHONY_PHONE_NUMBER (your Twilio number, E.164 format),
# and PUBLIC_BASE_URL above.
TELEPHONY_PROVIDER=mock
TELEPHONY_API_KEY=
TELEPHONY_API_SECRET=
TELEPHONY_PHONE_NUMBER=

# --- Embeddings (for knowledge base / pgvector semantic search) ---
# Valid values: mock, google
# google requires EMBEDDING_API_KEY (falls back to AI_API_KEY if unset,
# since they're commonly the same Google API key)
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# --- Business Integrations (CRM/ERP/custom API credentials, encrypted at rest) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Frontend (only used in local `vite dev`; unused when Express serves the built app) ---
VITE_API_URL=
