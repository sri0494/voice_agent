NODE_ENV=development
PORT=10000

# --- Database (Neon Postgres pooled connection string) ---
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/leomox?sslmode=require

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# --- AI Provider (LLM) ---
AI_PROVIDER=mock
AI_API_KEY=

# --- Speech to Text ---
STT_PROVIDER=mock
STT_API_KEY=

# --- Text to Speech ---
TTS_PROVIDER=mock
TTS_API_KEY=

# --- Telephony (must be an India-compliant provider e.g. Exotel/Knowlarity/Ozonetel/Twilio-IN) ---
TELEPHONY_PROVIDER=mock
TELEPHONY_API_KEY=
TELEPHONY_API_SECRET=
TELEPHONY_PHONE_NUMBER=
TELEPHONY_WEBHOOK_SECRET=

# --- Embeddings (for knowledge base / pgvector) ---
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=

# --- Business Integrations (CRM/ERP/custom API credentials, encrypted at rest) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Frontend (only used in local `vite dev`; unused when Express serves the built app) ---
VITE_API_URL=
